{
    "_version": "1.59.0",
    "sap.app": {
        "id": "com.mycompany.fioriapp",
        "type": "application",
        "i18n": {
            "bundleUrl": "i18n/i18n.properties",
            "supportedLocales": [""],
            "fallbackLocale": ""
        },
        "applicationVersion": { "version": "0.0.1" },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "dataSources": {
            "mainService": {
                "uri": "odata/v4/inventory/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.cloud": {
        "public": true,
        "service": "comcompanyfioriapp"
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.layout": {}
            }
        },
        "contentDensities": { "compact": true, "cozy": true },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "com.mycompany.fioriapp.i18n.i18n",
                    "supportedLocales": [""],
                    "fallbackLocale": ""
                }
            },
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            }
        },
        "resources": {
            "css": [{ "uri": "css/style.css" }]
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "type": "View",
                "viewType": "XML",
                "path": "com.mycompany.fioriapp.view",
                "controlId": "app",
                "controlAggregation": "pages",
                "async": true
            },
            "routes": [
                { "name": "main", "pattern": "", "target": "main" },
                { "name": "detail", "pattern": "products/{productId}", "target": "detail" }
            ],
            "targets": {
                "main": { "id": "main", "name": "Main", "level": 1 },
                "detail": { "id": "detail", "name": "Detail", "level": 2 }
            }
        },
        "rootView": {
            "viewName": "com.mycompany.fioriapp.view.App",
            "type": "XML",
            "id": "App"
        }
    }
}
