{
  "name": "fioriapp",
  "version": "0.0.1",
  "description": "Warehouse Inventory - SAPUI5 Fiori freestyle application",
  "private": true,
  "scripts": {
    "start": "ui5 serve --open index.html",
    "build": "ui5 build --clean-dest",
    "build:cf": "ui5 build --config ui5-deploy.yaml --clean-dest --include-task=generateCachebusterInfo"
  },
  "devDependencies": {
    "@ui5/cli": "^4.0.0",
    "ui5-middleware-simpleproxy": "^3.0.0",
    "ui5-task-zipper": "^3.4.0"
  }
}
